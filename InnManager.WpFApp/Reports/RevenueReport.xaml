<UserControl x:Class="InnManager.WpFApp.Reports.RevenueReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Reports"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" Background="#E9FCEE">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1" CornerRadius="5, 5, 0, 0" BorderBrush="Gray">
                <TextBlock Text="Revenue Report" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>

            <Grid Margin="20" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Room Charges:" FontSize="24" TextAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Service Charges:" FontSize="24" TextAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Tax:" FontSize="24" TextAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Invoice Amount:" FontSize="24" TextAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Total Paid Amount:" FontSize="24" TextAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Outstanding Balance:" FontSize="24" TextAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalRoomCharges, StringFormat={}{0:C}}" FontSize="24" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalServiceCharges, StringFormat={}{0:C}}" FontSize="24" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RevenueTaxDisplay}" FontSize="24" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalInvoiceAmount, StringFormat={}{0:C}}" FontSize="24" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalPaidAmount, StringFormat={}{0:C}}" FontSize="24" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OutstandingBalance, StringFormat={}{0:C}}" FontSize="24" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
