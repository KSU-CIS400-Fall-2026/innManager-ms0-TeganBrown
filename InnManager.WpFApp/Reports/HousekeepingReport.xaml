<UserControl x:Class="InnManager.WpFApp.Reports.HousekeepingReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Reports"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" Background="#E9FCEE">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1" CornerRadius="5, 5, 0, 0" BorderBrush="Gray">
                <TextBlock Text="Housekeeping Report" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>

            <DockPanel Grid.Row="1" LastChildFill="False">
                <Border CornerRadius="5" Background="LightGray" Margin="15" BorderBrush="Gray" BorderThickness="1" Height="100" Width="150">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Tasks" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalHousekeepingTasks, StringFormat={}{0}}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="5" Background="Orange" Margin="15" BorderBrush="DarkRed" BorderThickness="1" Height="100" Width="150">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="In Progress Tasks" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding InProgressHousekeepingTasks, StringFormat={}{0}}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="5" Margin="15" Background="MediumPurple" BorderBrush="Gray" BorderThickness="1" Height="100" Width="150">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Completed Tasks" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CompletedHousekeepingTasks, StringFormat={}{0}}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
