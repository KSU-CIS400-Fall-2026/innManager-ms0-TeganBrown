<Window x:Class="InnManager.WpFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpFApp"
        xmlns:controls="clr-namespace:InnManager.WpFApp.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Aquamarine"/>
            <Setter Property="BorderBrush" Value="Green"/>
        </Style>
        <Style TargetType="DockPanel">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                    
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="LightGray" BorderThickness="2" Grid.Row="1" Grid.Column="1" CornerRadius="5" Margin="5">
            <controls:DashboardControl Grid.Row="1" Grid.Column="1"/>
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Height="350" Width="125" Margin="10,10,10,10" Grid.Row="1" Grid.Column="0">
            <Button Content="Dashboard"/>
            <Button Content="Rooms"/>
            <Button Content="Reservations"/>
            <Button Content="Guests"/>
            <Button Content="Services"/>
            <Button Content="Invoices"/>
            <Button Content="Payments"/>
            <Button Content="Employees"/>
            <Button Content="Housekeeping"/>
            <Button Content="Reports"/>
            <Button Content="Settings"/>
        </StackPanel>
        <Border BorderBrush="SeaGreen" BorderThickness="2" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="5" Margin="5">
            <DockPanel Margin="0,0,0,0" Background="LightSeaGreen">
                <TextBlock Text="InnManager" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="25" FontWeight="Bold" Margin="20,0,0,0"/>
                <TextBlock Text="Hotel Management System" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="16" Foreground="DarkGreen" Margin="0,0,20,0"/>
            </DockPanel>
        </Border>
        
    </Grid>
</Window>
