<UserControl x:Class="InnManager.WpFApp.Controls.Editors.InvoiceEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls.Editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Grid Background="#E9FCEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="#70EB95" BorderThickness="0,0,0,1" BorderBrush="Green">
            <TextBlock Text="View Invoice" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Guest:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="GuestTextBlock" Margin="1" Text="{Binding GuestName, Mode=TwoWay}"/>
            </Border>
            <TextBlock Text="Room Number:" VerticalAlignment="Center" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="RoomNumberTextBlock" Margin="1" Text="{Binding RoomNumber, Mode=TwoWay}"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Total ($):" VerticalAlignment="Center" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="TotalAmountTextBlock" Margin="1" Text="{Binding TotalAmount, Mode=TwoWay}"/>
            </Border>
            <TextBlock Text="Paid ($):" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="PaidAmountTextBlock" Margin="1" Text="{Binding TotalPayments, Mode=TwoWay}"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Invoice Date:" VerticalAlignment="Center" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="InvoiceDateTextBlock" Margin="1" Background="White" Text="{Binding InvoiceDate, Mode=TwoWay}"/>
            </Border>
            <TextBlock Text="Due Date:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="DueDateTextBlock" Margin="1" Text="{Binding DueDate, Mode=TwoWay}"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Invoice #:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="InvoiceNumberTextBlock" Margin="1" Text="{Binding InvoiceNumber, Mode=TwoWay}"/>
            </Border>
            <TextBlock Text="Status:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,0" Background="White">
                <TextBlock x:Name="StatusTextBlock" Margin="1" Text="{Binding Status, Mode=TwoWay}"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Grid.RowSpan="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="15" Background="White">
            
        </Border>

        <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="0,1,0,0"/>
        <DockPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="Back" Width="90" Height="40" BorderBrush="Gray" Click="BackButtonClick" Margin="20,0,20,0" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold"/>
            
        </DockPanel>
    </Grid>
</UserControl>
