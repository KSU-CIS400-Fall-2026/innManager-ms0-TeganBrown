<UserControl x:Class="InnManager.WpFApp.Controls.Editors.PaymentRefundControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Grid Background="#E9FCEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="#70EB95" BorderThickness="0,0,0,1" BorderBrush="Green">
            <TextBlock Text="Refund Payment" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Payment Date:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBlock Margin="1" Text="{Binding date}" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Payment Method:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBlock Margin="1" Text="{Binding PaymentMethod}" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Amount ($):" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBlock Margin="1" Text="{Binding Amount}" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Processed:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBlock Margin="1" Text="{Binding IsProcessed}" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Reference Number:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBlock Margin="1" Text="{Binding RefrenceNumber}" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Description:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBlock Margin="1" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="0,1,0,0"/>
        <DockPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="Back" Width="90" Height="40" BorderBrush="Gray" Click="BackButtonClick" Margin="20,0,20,0" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold"/>
			<Button Content="Refund Payment" Width="130" Height="40" BorderBrush="DarkRed" Background="Red" Foreground="White" Click="RefundPaymentClick" Margin="20,0,20,0" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</UserControl>
