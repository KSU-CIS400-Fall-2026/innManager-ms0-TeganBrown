<UserControl x:Class="InnManager.WpFApp.Controls.Editors.ServiceEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls.Editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Grid Background="#E9FCEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="#70EB95" BorderThickness="0,0,0,1" BorderBrush="Green">
            <TextBlock Text="Edit Service" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Service Name:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="NameTextBox" Margin="1" BorderBrush="White" Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Price ($):" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="PriceTextBox" Margin="1" BorderBrush="White" Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Category:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <ComboBox x:Name="CategoryComboBox" Margin="1" Background="White" BorderBrush="White" SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,5,10,5">
            <CheckBox x:Name="IsAvailableCheckBox" Content="Available" VerticalAlignment="Center" Margin="5,5,0,0" FontSize="10" IsChecked="{Binding IsAvailable, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="10,5,10,5">
            <TextBlock Text="Description:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="DescriptionTextBox" Margin="1" BorderBrush="White" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="0,1,0,0"/>
        <DockPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="40" BorderBrush="Gray" Click="CancelButtonClick" Margin="20,0,20,0" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold"/>
            <Button Content="Save" Width="90" Height="40" Background="DarkGreen" BorderBrush="DarkGreen" Click="SaveButtonClick" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</UserControl>
