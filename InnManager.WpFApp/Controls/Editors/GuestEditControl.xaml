<UserControl x:Class="InnManager.WpFApp.Controls.Editors.GuestEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls.Editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Grid Background="#E9FCEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="#70EB95" BorderThickness="0,0,0,1" BorderBrush="Green">
            <TextBlock Text="Edit Guest" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="First Name:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="FirstNameTextBox" Margin="1" BorderBrush="White" Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Last Name:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="LastNameTextBox" Margin="1" BorderBrush="White" Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Phone Number:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="PhoneNumberTextBox" Margin="1" BorderBrush="White" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="4" Grid.Column="0" Margin="10,5,10,5">
            <TextBlock Text="Address:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="AddressTextBox" Margin="1" BorderBrush="White" Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="Email:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="EmailTextBox" Margin="1" BorderBrush="White" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="ID Type:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <ComboBox x:Name="IDTypeComboBox" Margin="1" Background="White" BorderBrush="White" SelectedItem="{Binding IDType, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Grid.Column="1" Margin="10,5,10,5">
            <TextBlock Text="ID Number:" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="IDNumberTextBox" Margin="1" BorderBrush="White" Text="{Binding IDNumber, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,5,10,5">
            <CheckBox x:Name="CheckedInCheckBox" Content="Checked In" VerticalAlignment="Center" Margin="5,5,0,0" FontSize="10" IsChecked="{Binding IsCheckedIn, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
        </StackPanel>

        <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="0,1,0,0"/>
        <DockPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="40" BorderBrush="Gray" Click="CancelButtonClick" Margin="20,0,20,0" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold"/>
            <Button Content="Save" Width="90" Height="40" Background="DarkGreen" BorderBrush="DarkGreen" Click="SaveButtonClick" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</UserControl>
