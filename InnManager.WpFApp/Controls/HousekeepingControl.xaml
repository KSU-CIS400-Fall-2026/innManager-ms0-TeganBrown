<UserControl x:Class="InnManager.WpFApp.Controls.HousekeepingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             xmlns:editor="clr-namespace:InnManager.WpFApp.Controls.Editors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Grid>
    <Border x:Name="HousekeepingPanel" Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#70EB95" CornerRadius="5, 5, 0, 0">
                <TextBlock Text="Housekeeping" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>
            <DockPanel Grid.Row="1">
                <Border CornerRadius="5" Margin="10,7">
                    <Button Content="  + Add Task  " Background="DarkGreen" Foreground="White" FontWeight="SemiBold" Click="AddHousekeepingTaskClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Edit  " Background="#E9FCEE" FontWeight="SemiBold" Click="EditButtonClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Delete  " Background="#E9FCEE" FontWeight="SemiBold" Click="DeleteHousekeepingTaskClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Refresh  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <TextBox Text="Search room number, description, or staff..." Foreground="Gray" VerticalContentAlignment="Center"/>
                </Border>
            </DockPanel>

            <Border Grid.Row="3" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <TextBlock Text="Total Tasks: 0" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </Border>
            <Border Grid.Row="2" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <DataGrid x:Name="HousekeepingTasksDataGrid" ItemsSource="{Binding HousekeepingTasks}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Assigned Staff" Binding="{Binding AssignedStaff}" Width="*"/>
                        <DataGridTextColumn Header="Scheduled Date" Binding="{Binding ScheduledDate}" Width="*"/>
                        <DataGridTextColumn Header="Completed" Binding="{Binding IsCompleted}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
    <editor:HousekeepingEditControl x:Name="HousekeepingEditor" Visibility="Hidden"/>
    </Grid>
</UserControl>
