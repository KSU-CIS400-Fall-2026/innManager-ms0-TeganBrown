<UserControl x:Class="InnManager.WpFApp.Controls.ServicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             xmlns:editor="clr-namespace:InnManager.WpFApp.Controls.Editors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Grid>
    <Border x:Name="ServicePanel" Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#70EB95" CornerRadius="5, 5, 0, 0">
                <TextBlock Text="Services" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>
            <DockPanel Grid.Row="1">
                <Border CornerRadius="5" Margin="10,7">
                    <Button Content="  + Add Service  " Background="DarkGreen" Foreground="White" FontWeight="SemiBold" Click="AddServiceClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Edit  " Background="#E9FCEE" FontWeight="SemiBold" Click="EditButtonClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Delete  " Background="#E9FCEE" FontWeight="SemiBold" Click="DeleteServiceClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Refresh  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <TextBox Text="Search service name or category..." Foreground="Gray" VerticalContentAlignment="Center"/>
                </Border>
            </DockPanel>

            <Border Grid.Row="3" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <TextBlock Text="Total Services: 0" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </Border>
            <Border Grid.Row="2" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <DataGrid x:Name="ServicesDataGrid" ItemsSource="{Binding Services}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding IsAvailable}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
    <editor:ServiceEditControl x:Name="ServiceEditor" Visibility="Hidden"/>
    </Grid>
</UserControl>
