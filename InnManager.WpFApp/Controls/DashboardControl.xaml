<UserControl x:Class="InnManager.WpFApp.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" Background="#F3C4F2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="5, 5, 0, 0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#E278E1">
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10, 0, 0, 0"/>
            </Border>
            <Border CornerRadius="5" Grid.Row="1" Grid.Column="0" Background="LightGray" Margin="15" BorderBrush="Gray" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total Rooms" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="---" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="5" Grid.Row="1" Grid.Column="1" Background="LightGreen" Margin="15" BorderBrush="Green" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Available Rooms" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="---" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="5" Grid.Row="1" Grid.Column="2" Background="LightCoral" Margin="15" BorderBrush="DarkRed" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Occupied Rooms" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="---" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="15" Background="GhostWhite" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Recent Reservations" FontSize="20" Grid.Row="0" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <Border Grid.Row="1" Margin="5" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                        <DataGrid x:Name="DashboardReservationsDataGrid" ItemsSource="{Binding Reservations}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Guest" Binding="{Binding GuestName}" Width="2*"/>
                                <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" Width="*"/>
                                <DataGridTextColumn Header="Check-In" Binding="{Binding CheckInDate}" Width="2*"/>
                                <DataGridTextColumn Header="Check-Out" Binding="{Binding CheckOutDate}" Width="2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Margin="15" Background="GhostWhite" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Room Status" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" Grid.Row="0"/>
                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5">
                        <StackPanel>
                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Available" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="15" Margin="10,0,0,0" FontWeight="DemiBold"/>
                                    <TextBlock Text="---" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15" Margin="0,0,10,0" FontWeight="DemiBold"/>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Occupied" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="15" Margin="10,0,0,0" FontWeight="DemiBold"/>
                                    <TextBlock Text="---" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15" Margin="0,0,10,0" FontWeight="DemiBold"/>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Out of Service" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="15" Margin="10,0,0,0" FontWeight="DemiBold"/>
                                    <TextBlock Text="---" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15" Margin="0,0,10,0" FontWeight="DemiBold"/>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Maintenance" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="15" Margin="10,0,0,0" FontWeight="DemiBold"/>
                                    <TextBlock Text="---" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15" Margin="0,0,10,0" FontWeight="DemiBold"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
