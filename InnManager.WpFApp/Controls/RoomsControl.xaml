<UserControl x:Class="InnManager.WpFApp.Controls.RoomsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>
    
    <Border Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#70EB95" CornerRadius="5, 5, 0, 0">
                <TextBlock Text="Rooms" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>
            <DockPanel Grid.Row="1">
                <Border CornerRadius="5" Margin="10,7">
                    <Button Content="  + Add Room  " Background="DarkGreen" Foreground="White" FontWeight="SemiBold" Click="AddRoomClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Edit  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Delete  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Refresh  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <TextBox Text="Search room number..." Foreground="Gray" VerticalContentAlignment="Center"/>
                </Border>
            </DockPanel>

            <Border Grid.Row="3" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <TextBlock Text="{Binding Rooms.Count, StringFormat='Total Rooms: {0}'}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </Border>
            <Border Grid.Row="2" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Rooms}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room Number" Binding="{Binding roomNumber}" Width="*"/>
                        <DataGridTextColumn Header="Room Type" Binding="{Binding roomType}" Width="*"/>
                        <DataGridTextColumn Header="Floor" Binding="{Binding Floor}" Width="*"/>
                        <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="*"/>
                        <DataGridTextColumn Header="Rate ($)" Binding="{Binding NightlyRate}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="Is Clean" Binding="{Binding IsClean}" Width="*"/>
                        <DataGridTextColumn Header="Has Balcony" Binding="{Binding HasBalcony}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</UserControl>
