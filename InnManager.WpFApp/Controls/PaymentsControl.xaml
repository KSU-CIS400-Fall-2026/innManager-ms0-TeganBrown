<UserControl x:Class="InnManager.WpFApp.Controls.PaymentsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             xmlns:viewer="clr-namespace:InnManager.WpFApp.Controls.Editors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Border Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid x:Name="PaymentsPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#70EB95" CornerRadius="5, 5, 0, 0">
                <TextBlock Text="Payments" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>
            <DockPanel Grid.Row="1">
                <Border CornerRadius="5" Margin="10,7">
                    <Button Content="  + New Payment  " Background="DarkGreen" Foreground="White" FontWeight="SemiBold" Click="AddPaymentClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  View  " Background="#E9FCEE" FontWeight="SemiBold" Click="ViewPaymentClick"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Receipt  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Refund  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Refresh  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <TextBox Text="Search invoice number, guest name, or refrence..." Foreground="Gray" VerticalContentAlignment="Center"/>
                </Border>
            </DockPanel>

            <Border Grid.Row="3" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <TextBlock Text="{Binding Payments.Count, StringFormat='Total Payments: {0}'}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </Border>
            <Border Grid.Row="2" Margin="10" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <DataGrid x:Name="PaymentsDataGrid" ItemsSource="{Binding Payments}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Payment Date" Binding="{Binding date}" Width="*"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="*"/>
                        <DataGridTextColumn Header="Amount ($)" Binding="{Binding Amount}" Width="*"/>
                        <DataGridTextColumn Header="Processed" Binding="{Binding IsProcessed}" Width="*"/>
                        <DataGridTextColumn Header="Reference #" Binding="{Binding RefrenceNumber}" Width="*"/>
                            <DataGridTextColumn Header="Refunded" Binding="{Binding IsRefunded}" Width="*"/>
                        </DataGrid.Columns>
                </DataGrid>
            </Border>
            </Grid>
            <viewer:PaymentViewControl x:Name="PaymentViewer" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
