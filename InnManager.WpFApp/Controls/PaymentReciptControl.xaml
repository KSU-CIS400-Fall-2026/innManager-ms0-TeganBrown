<UserControl x:Class="InnManager.WpFApp.Controls.PaymentReciptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="2" Margin="10,0,10,0" BorderThickness="0,0,0,1" BorderBrush="Gray">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="35" FontWeight="Bold" Text="{Binding HotelName}"/>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="DarkSlateGray">Payment Receipt</TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="15">
                <TextBlock>Payment Reference:</TextBlock>
                <TextBlock>Invoice Number:</TextBlock>
                <TextBlock>Payment Date:</TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="15">
                <TextBlock Text="{Binding PaymentRef}"/>
                <TextBlock Text="{Binding InvoiceNum}"/>
                <TextBlock Text="{Binding PaymentDate, StringFormat='dd/MM/yyyy'}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="15">
                <TextBlock>Guest:</TextBlock>
                <TextBlock>Room:</TextBlock>
            </StackPanel>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,10,0" BorderThickness="0,0,0,1" BorderBrush="LightGray"/>
            
            <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="15">
                <TextBlock Text="{Binding GuestName}"/>
                <TextBlock Text="{Binding RoomNum}"/>
            </StackPanel>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,10,0" BorderThickness="0,0,0,1" BorderBrush="LightGray"/>

            <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="15">
                <TextBlock>Total Amount:</TextBlock>
                <TextBlock>Amount Paid:</TextBlock>
                <TextBlock>Remaining Balance:</TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="15">
                <TextBlock Text="{Binding InvoiceTotal, StringFormat='C'}"/>
                <TextBlock Text="{Binding AmountPaid, StringFormat='C'}"/>
                <TextBlock Text="{Binding RemainingBalance, StringFormat='C'}"/>
            </StackPanel>

            <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="10,0,10,0" BorderThickness="0,0,0,1" BorderBrush="LightGray"/>

            <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="15">
                <TextBlock>Payment Method:</TextBlock>
                <TextBlock>Status:</TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="15">
                <TextBlock Text="{Binding PaymentMethod}"/>
                <TextBlock Text="{Binding Status}"/>
            </StackPanel>
            
            <DockPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="5" LastChildFill="False">
                <Button Content="Save Receipt" Background="Green" BorderBrush="DarkGreen" Foreground="White" FontWeight="SemiBold" Click="SaveButtonClick" Margin="0,0,10,0"/>
                <Button Content="Back" Background="Gray" BorderBrush="DarkGray" FontWeight="SemiBold" Click="BackButtonClick"/>
            </DockPanel>

        </Grid>
    </Border>
</UserControl>
