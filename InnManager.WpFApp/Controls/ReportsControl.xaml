<UserControl x:Class="InnManager.WpFApp.Controls.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Control.Resources>

    <Border Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#70EB95" CornerRadius="5, 5, 0, 0">
                <TextBlock Text="Reports" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Border>
            <DockPanel Grid.Row="1" LastChildFill="False">
                <Border CornerRadius="5" Margin="10,7">
                    <Button Content="  Occupancy Report  " Background="DarkGreen" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Revenue Report  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Guest Report  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Housekeeping Report  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Reservation Report  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="5" Margin="7,7">
                    <Button Content="  Employee Report  " Background="#E9FCEE" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
