<UserControl x:Class="InnManager.WpFApp.Settings.ReservationBilling"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border BorderThickness="0,0,0,1" BorderBrush="Gray">
                <TextBlock FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Margin="10">Reservation and Billing</TextBlock>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <DockPanel Margin="5">
                        <TextBlock FontSize="20">Tax Rate:</TextBlock>
                        <TextBox x:Name="TaxRateTextBox" Width="40" Margin="158,0,0,0" VerticalContentAlignment="Center" FontSize="15" Text="{Binding TaxRate, Mode=TwoWay, StringFormat={}{0:F2}}"/>
                        <TextBlock FontSize="20" Margin="5,0,0,0">%</TextBlock>
                    </DockPanel>
                    <DockPanel Margin="5" LastChildFill="False">
                        <TextBlock FontSize="20">Default Check-In Time:</TextBlock>
                        <TextBox x:Name="CheckInHourTextBox" Width="40" Margin="35,0,0,0" VerticalContentAlignment="Center" FontSize="15" Text="{Binding DefaultCheckInTime.Hours, Mode=OneWay}"/>
                        <TextBlock FontSize="20" Margin="5,0,5,0">:</TextBlock>
                        <TextBox x:Name="CheckInMinuteTextBox" Width="40" Margin="0,0,0,0" VerticalContentAlignment="Center" FontSize="15" Text="{Binding DefaultCheckInTime.Minutes, Mode=OneWay, StringFormat={}{0:00}}"/>
                    </DockPanel>
                    <DockPanel Margin="5" LastChildFill="False">
                        <TextBlock FontSize="20">Default Check-Out Time:</TextBlock>
                        <TextBox x:Name="CheckOutHourTextBox" Width="40" Margin="20,0,0,0" VerticalContentAlignment="Center" FontSize="15" Text="{Binding DefaultCheckOutTime.Hours, Mode=OneWay}"/>
                        <TextBlock FontSize="20" Margin="5,0,5,0">:</TextBlock>
                        <TextBox x:Name="CheckOutMinuteTextBox" Width="40" Margin="0,0,0,0" VerticalContentAlignment="Center" FontSize="15" Text="{Binding DefaultCheckOutTime.Minutes, Mode=OneWay, StringFormat={}{0:00}}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <Border BorderThickness="0,1,0,0" BorderBrush="Gray" Grid.Row="2">
                <DockPanel HorizontalAlignment="Right">
                    <Button Foreground="White" Background="Green" FontWeight="SemiBold" Margin="10" Width="90" Click="SaveClick">Save Changes</Button>
                    <Button FontWeight="SemiBold" Margin="10" Width="50" Click="CancelClick">Cancel</Button>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
