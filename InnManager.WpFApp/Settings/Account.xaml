<UserControl x:Class="InnManager.WpFApp.Settings.Account"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpFApp.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#E9FCEE" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border BorderThickness="0,0,0,1" BorderBrush="Gray">
                <TextBlock FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Margin="10">Account</TextBlock>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="10">
                    <DockPanel Margin="5">
                        <TextBlock FontSize="20">Display Name:</TextBlock>
                        <TextBox x:Name="DisplayNameTextBox" Width="200" Margin="10,0,0,0" VerticalContentAlignment="Center" FontSize="15" IsEnabled="False">Hotel Admin</TextBox>
                    </DockPanel>
                    <DockPanel Margin="5">
                        <TextBlock FontSize="20">Email:</TextBlock>
                        <TextBox x:Name="EmailTextBox" Width="200" Margin="85,0,0,0" VerticalContentAlignment="Center" FontSize="15" IsEnabled="False">admin@hotel.com</TextBox>
                    </DockPanel>
                    <DockPanel Margin="5">
                        <TextBlock FontSize="20">Phone Number:</TextBlock>
                        <TextBox x:Name="PhoneTextBox" Width="200" Margin="0,0,0,0" VerticalContentAlignment="Center" FontSize="15" IsEnabled="False">123-456-7890</TextBox>
                    </DockPanel>
                    <DockPanel Margin="5">
                        <TextBlock FontSize="20">Position:</TextBlock>
                        <TextBox x:Name="PositionTextBox" Width="200" Margin="68,0,0,0" VerticalContentAlignment="Center" FontSize="15" IsEnabled="False">Admin</TextBox>
                    </DockPanel>
                    <DockPanel Margin="5">
                        <TextBlock FontSize="20">Department:</TextBlock>
                        <TextBox x:Name="DepartmentTextBox" Width="200" Margin="32,0,0,0" VerticalContentAlignment="Center" FontSize="15" IsEnabled="False">Management</TextBox>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <Border BorderThickness="0,1,0,0" BorderBrush="Gray" Grid.Row="2">
                <DockPanel HorizontalAlignment="Right">
                    <Button Foreground="White" Background="Green" FontWeight="SemiBold" Margin="10" Width="90" Click="SaveClick">Save Changes</Button>
                    <Button FontWeight="SemiBold" Margin="10" Width="50" Click="CancelClick">Cancel</Button>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
