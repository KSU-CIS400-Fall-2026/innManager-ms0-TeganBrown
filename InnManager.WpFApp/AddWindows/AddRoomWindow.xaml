<Window x:Class="InnManager.WpFApp.AddWindows.AddRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpFApp.AddWindows"
        mc:Ignorable="d"
        Title="Add New Room" Height="300" Width="325">
    <Grid Background="#E9FCEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="#70EB95" BorderThickness="0,0,0,1" BorderBrush="Green">
            <TextBlock Text="Add New Room" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="10,5,10,5" >
            <TextBlock Text="Room Number:" VerticalAlignment="Center" Margin="0,0,0,0" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="RoomNumberTextBox" Margin="1,1,1,1" BorderBrush="White"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="0" Margin="10,5,10,5" >
            <TextBlock Text="Room Type:" VerticalAlignment="Center" Margin="0,0,0,0" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <ComboBox x:Name="RoomTypeComboBox" Margin="1,1,1,1" Background="White" BorderBrush="White" ItemsSource="{Binding RoomType}"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Grid.Column="0" Margin="10,5,10,5" >
            <TextBlock Text="Floor:" VerticalAlignment="Center" Margin="0,0,0,0" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="FloorTextBox" Margin="1,1,1,1" BorderBrush="White"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="4" Grid.Column="0" Margin="10,5,10,5" >
            <TextBlock Text="Capacity:" VerticalAlignment="Center" Margin="0,0,0,0" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="CapacityTextBox" Margin="1,1,1,1" BorderBrush="White"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,5,10,5" >
            <TextBlock Text="Rate ($):" VerticalAlignment="Center" Margin="0,0,0,0" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <TextBox x:Name="RateTextBox" Margin="1,1,1,1" BorderBrush="White"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="1" Margin="10,5,10,5" >
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,0,0" DockPanel.Dock="Top" FontSize="10"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <ComboBox x:Name="StatusComboBox" Margin="1,1,1,1" Background="White" BorderBrush="White" ItemsSource="{Binding RoomStatus}"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" Margin="10,5,10,5" >
            <CheckBox x:Name="IsCleanCheckBox" Content="Is Clean" VerticalAlignment="Center" Margin="5,5,0,0" FontSize="10"/>
            <CheckBox x:Name="HasBalconyCheckBox" Content="Has Balcony" VerticalAlignment="Center" Margin="5,5,0,0" FontSize="10"/>
        </StackPanel>
        
        <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="0,1,0,0"/>
        <DockPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="20"  BorderBrush="Gray" Click="CancelButtonClick" Margin="5" DockPanel.Dock="Right"/>
            <Button Content="Add Room" Width="90" Height="20" Background="#70EB95" BorderBrush="Green" Click="AddRoomButtonClick"/>
        </DockPanel>
    </Grid>
</Window>

                    